# Copy to .env and fill in (setup.sh --docker makes one for you with a random password).

# Password for the web interface (required when it listens beyond localhost, as it does in Docker)
TRADEALERTS_PASSWORD=change-me-to-a-long-password

# Optional: config.yaml can read any value from the environment, e.g. topic: ${NTFY_TOPIC}
# NTFY_TOPIC=
# NTFY_TOKEN=
# OANDA_TOKEN=
